@article{HashimotoEtAlReliability1982,
  title = {Reliability, Resiliency, and Vulnerability Criteria for Water Resource System Performance Evaluation},
  author = {Hashimoto, Tsuyoshi and Stedinger, Jery R. and Loucks, Daniel P.},
