@techreport{RomeroRobinson20232024,
  title = {2023 {{SCOTT RIVER JUVENILE SALMONID OUTMIGRANT STUDY}}},
  author = {Romero, Rosemary and Robinson, Crystal},
  year = 2024,
  pages = {60},
  address = {Yreka, CA},
  institution = {{California Department of Fish and Wildlife}},
  abstract = {The 2023 Scott River Juvenile Salmonid Outmigrant Study is part of the ongoing work conducted by the California Department of Fish and Wildlife and the Klamath Watershed Program on the Shasta and Scott Rivers in Siskiyou County, California. The Scott River rotary screw trap has been in operation since 2000. One rotary screw trap was operated from February 21 to July 14, 2023, to sample all age classes of Chinook Salmon (Oncorhynchus tshawytscha), Coho Salmon (Oncorhynchus kisutch), and steelhead (Oncorhynchus mykiss) emigrating from the Scott River. Mark and recapture trials were conducted multiple times per week to determine trap efficiencies and weekly population estimates. Established age-length cutoffs for each species were used to determine the age of the fish captured. In-stream conditions such as flow and water temperature were also monitored. Weekly estimates for the smolt class of all target species were compared to previous results to evaluate multi-year population trends. Additionally, using multi-year seasonal production estimates and Coho Salmon adult returns to the Scott River, adult survival and smolt production estimates were calculated. For the period sampled in 2023, we estimated that a total of 12,540 0+ and 4,014 1+ Coho Salmon; and 26,337 0+, and 8,775 1+ emigrated from the Scott River. Mark-recapture efficiency trials could not be conducted or were not successful for Chinook salmon, and age 2+ and 3+ Steelhead so production estimates were not generated for these species age classes in 2023.},
  langid = {english},
  file = {C:\Users\ck798\Zotero\storage\S8P9ATW3\Romero and Robinson - Funded by the California Department of Fish and Wildlife Fisheries Restoration Grants Program, #CMP-.pdf}
}

