isbn = {1027-5606},
issn = {10275606},
journal = {Hydrology and Earth System Sciences},
number = {6},
pages = {1125--1138},
pmid = {18831719},
title = {{The utility of daily large-scale climate data in the assessment of climate change impacts on daily streamflow in California}},
volume = {14},
year = {2010}
}
