@incollection{OSullivan2010e,
annote = {Point pattern definition
May be more than one event at a given location

Point pattern analysis: points mapped on a plane. Study area objectively determined. Should include all relevant entities in the study region (not a sample). Event locations should be proper. 

Read through a "clean" problem before diving into messy real world data. Get a grounding in the assumptions first.

How do we describe a point pattern quantitatively? point density and point separation. Related to first- and second-order effects. First-order: absolute location is important (density-based descriptions); second-order: interaction/relative location is important. Usually impossible to distinguish these effects in practIce.

Centrography: mean center, standard distance; summary circle, standard distance ellipse

Density-based methods: overall density/intensity, quadrat counts (evenly spaced or randomly sampled). Variance-Mean Ratio. Should be 1.0 if distribution is Poisson one way to test for ISP/CSR)

Distance-based point pattern measures: nearest-neighbor; mean nearest-neighbor distance; G function: refined nearest-neighbor (cumulative frequency distribution of the nearest-neighbor distances); F-function ( cumulative frequency distribution for distances between random locations and events in set). K-functions on all the distances between events in S: compute average densities around ALL points at various radii (d); plot over d.

Then: How clustered? 5.3, assessing point patterns statistically.

"while hypothesis testing is possible for quadrat count data, it is not reliable unless we are dealing with very large point data sets with a high mean intensity of events per quadrat."

Distance testing: Clark and Evans' R statistic: E(d) = 1/2sqrt(lambda). d{\_}min / E(d) = R. If R 1, tendency to evenly spaced points. F and G curves are on the opposite sides of the expected value line. L function is a transformation that is used to compare the K(d) fuction to 0. 

Monte Carlo simulations used to generate expected values for, e.g., minimum distance, K(d), L(d). Advantages: no need for edge/area of study corrections; less sensitive to changing sample size; and spatial process models other than IRP can be investigated. 

first-order: density; quadrat counts and kernel-density. second-order (clustering): distance-based measures. mean nearest-neighbor, G, F, and K functions},
author = {O'Sullivan, David and Unwin, David J},
booktitle = {Geographic Information Analysis},
chapter = {5},
pages = {121--155},
publisher = {John Wiley {\&} Sons, Inc.},
title = {{Point Pattern Analysis}},
year = {2010}
}
@article{Gailey2019,
abstract = {A hydro-economic approach for planning on-farm managed aquifer recharge is developed and demonstrated for two contiguous sub-basins in California's Central Valley, USA. The amount and timing of water potentially available for recharge is based on a reoperation study for a nearby surface-water reservoir. Privately owned cropland is intermittently used for recharge with payments to landowners that compensate for perceived risks to crop health and productivity. Using all cropland in the study area would have recharged approximately 4.8 km3 (3,900 thousand acre-feet) over the 20-year analysis period. Limits to recharge effectiveness are expected from (1) temporal variability in recharge water availability, (2) variations in infiltration rate and few high-infiltration recharge sites in the study area, and (3) recharged water escaping from the study area groundwater system to surface water and adjacent sub-basins. Depending on crop tolerance to ponding depth, these limitations might be reduced by (1) raising berm heights on higher-infiltration-rate croplands and (2) creating dedicated recharge facilities over high-infiltration-rate sites.},
author = {Gailey, Robert M. and Fogg, Graham E. and Lund, Jay R. and Medell{\'{i}}n-Azuara, Josu{\'{e}}},
doi = {10.1007/s10040-019-01936-x},
file = {:C$\backslash$:/Users/Claire/Documents/Mendeley Citation Library/Gailey{\_}et{\_}al-2019-Hydrogeology{\_}Journal.pdf:pdf},
issn = {14350157},
journal = {Hydrogeology Journal},
keywords = {Agriculture,Artificial recharge,Hydro-economic modeling,Reservoir reoperation,USA},
number = {4},
pages = {1183--1206},
title = {{Maximizing on-farm groundwater recharge with surface reservoir releases: a planning approach and case study in California, USA}},
volume = {27},
year = {2019}
}
