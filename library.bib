journal = {Journal of Geophysical Research},
keywords = {doi:10.1029/9,http://dx.doi.org/10.1029/96JD01448},
number = {D16},
pages = {20},
title = {{One-dimensional statistical dynamic representation of subgrid spatial variability of precipitation in the two-layer variable infiltration capacity model}},
volume = {101},
year = {1996}
}
